# Copia este archivo a .env.dev (desarrollo), .env.test (pruebas) y/o .env.prod
# (producción) y ajusta los valores. Ninguno de esos tres se sube al repo.
#
# Los scripts npm ya apuntan al archivo correcto en cada caso (ver package.json):
# `npm run dev` usa .env.dev, `npm test` usa .env.test, `npm start` usa .env.prod.

PORT=3000

# Base de datos: asume un Postgres local ya instalado y corriendo (sin Docker). El
# usuario debe tener permiso de CREATEDB para que `npm run db:setup` pueda crear la
# base si no existe. En .env.test, usar un DB_NAME distinto (p. ej. barber_kong_test)
# para no pisar los datos de desarrollo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barber_kong
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change-this-secret-in-every-environment
JWT_EXPIRES_IN=2h

# URL del frontend (Vite dev server por defecto) — se usa para armar el enlace de
# restablecimiento de contraseña que se envía por correo.
FRONTEND_URL=http://localhost:5173

# Correo (notificaciones: 2FA, confirmaciones de cita, alertas de inventario)
# En desarrollo se puede usar https://ethereal.email para generar credenciales de prueba.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Barber Kong <no-reply@barberkong.com>"

# Logging (opcional, ver src/config/logger.js)
LOG_LEVEL=debug

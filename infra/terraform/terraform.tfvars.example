# Copiar este archivo a "terraform.tfvars" y completar los valores NO sensibles.
# Los valores sensibles (jwt_secret, db_app_password) NO van acá — se pasan como
# variables de entorno al correr terraform:
#
#   export TF_VAR_jwt_secret="..."
#   export TF_VAR_db_app_password="..."
#
# "terraform.tfvars" está en .gitignore — nunca se sube al repositorio.

supabase_organization_id = "<slug-de-tu-organizacion-en-supabase>"
supabase_region           = "us-east-1"

github_repo_frontend = "brandonsk8/Barber-Kong-Frontend"
github_repo_backend  = "brandonsk8/Barber-Kong"

api_url      = "https://barber-kong-api.vercel.app/api"
frontend_url = "https://barberkongs.vercel.app"
